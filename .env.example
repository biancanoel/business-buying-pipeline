# Copy this file to .env and fill in the values. .env is gitignored; never commit it.

# Anthropic API key, from https://console.anthropic.com (Settings > API keys)
ANTHROPIC_API_KEY=

# Supabase Postgres connection string: the Session pooler URI from the project's Connect panel,
# with your database password filled in.
DATABASE_URL=

# Optional: how this tool identifies itself to listing sites
# BUSINESS_FINDER_USER_AGENT=BusinessFinder/0.1 (personal business search; low-frequency)

# Optional: extraction model settings (defaults shown)
# BUSINESS_FINDER_EXTRACTION_PROVIDER=anthropic
# BUSINESS_FINDER_EXTRACTION_MODEL=claude-haiku-5-5
# BUSINESS_FINDER_EXTRACTION_EFFORT=low
